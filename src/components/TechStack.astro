---
import { Icon } from "astro-icon/components";

interface TechItem {
  name: string;
  icon: string;
  category?: string;
}

const technologies: TechItem[] = [
  { name: "Kotlin", icon: "simple-icons:kotlin", category: "Lenguaje" },
  { name: "Jetpack Compose", icon: "simple-icons:jetpackcompose", category: "UI Toolkit" },
  { name: "Android Studio", icon: "simple-icons:androidstudio", category: "IDE Oficial" },
  { name: "Android SDK", icon: "simple-icons:android", category: "Plataforma" },
  { name: "Gradle", icon: "simple-icons:gradle", category: "Build System" },
  { name: "Firebase", icon: "simple-icons:firebase", category: "Cloud & Auth" },
  { name: "SQLite", icon: "simple-icons:sqlite", category: "Persistencia" },
  { name: "Google Play", icon: "simple-icons:googleplay", category: "Distribución" },
];
---

<section class="w-full px-6 sm:px-12 lg:px-24 py-8">
  <div
    id="tech-stack-card"
    class="group relative w-full overflow-hidden rounded-2xl sm:rounded-3xl border border-w-border bg-w-base p-6 sm:p-8 lg:p-10 shadow-2xl transition-all duration-300"
  >
    <!-- Spotlight radial glow effect (color-w-accent with blur to transparent) -->
    <div
      class="pointer-events-none absolute -inset-px opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100"
      style="background: radial-gradient(450px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(201, 42, 62, 0.28), rgba(201, 42, 62, 0.08) 45%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <!-- Additional soft blur layer for atmospheric light dispersion -->
    <div
      class="pointer-events-none absolute -inset-px opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100 blur-3xl"
      style="background: radial-gradient(300px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(201, 42, 62, 0.25), transparent 75%);"
      aria-hidden="true"
    >
    </div>

    <!-- Header info -->
    <div class="tech-stack-header relative z-10 mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-w-border/40 pb-4">
      <div>
        <span class="text-xs font-semibold tracking-wider uppercase text-w-accent">
          Tecnologías Core
        </span>
        <h2 class="font-display text-xl sm:text-2xl font-bold text-w-text mt-1">
          Stack Nativo para Android
        </h2>
      </div>
      <p class="text-xs text-w-muted">
        Herramientas y tecnologías modernas para alto rendimiento móvil
      </p>
    </div>

    <!-- Horizontal responsive grid of technologies -->
    <div class="relative z-10 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3 sm:gap-4 lg:gap-5">
      {
        technologies.map((tech) => (
          <div
            class="tech-stack-item group/item relative flex flex-col items-center justify-center gap-3 rounded-xl border border-w-border/50 bg-w-surface/30 p-4 sm:p-5 text-center backdrop-blur-xs transition-all duration-300 hover:-translate-y-1 hover:border-w-accent/40 hover:bg-w-surface/70 hover:shadow-lg hover:shadow-w-accent/5"
          >
            <div class="tech-stack-icon-wrapper relative flex items-center justify-center">
              <Icon
                name={tech.icon}
                class="tech-stack-icon h-8 w-8 sm:h-9 sm:w-9 text-w-muted transition-colors duration-300 group-hover/item:text-w-text"
                aria-hidden="true"
              />
            </div>
            <div class="flex flex-col items-center gap-0.5">
              <span class="text-xs sm:text-sm font-medium text-w-muted transition-colors duration-300 group-hover/item:text-w-text">
                {tech.name}
              </span>
              {tech.category && (
                <span class="text-[10px] text-w-muted/60 transition-colors duration-300 group-hover/item:text-w-muted">
                  {tech.category}
                </span>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { animate, stagger } from 'animejs';

  function initTechStack() {
    const card = document.getElementById("tech-stack-card");
    if (!card) return;

    // 1. Interactive Spotlight tracking
    let rafId: number | null = null;
    const handleMouseMove = (e: MouseEvent) => {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty("--mouse-x", `${x}px`);
        card.style.setProperty("--mouse-y", `${y}px`);
      });
    };
    card.addEventListener("mousemove", handleMouseMove);

    // 2. Entrance Animation with anime.js via IntersectionObserver
    const header = card.querySelector(".tech-stack-header");
    const items = card.querySelectorAll(".tech-stack-item");

    let animated = false;
    const triggerEntrance = () => {
      if (animated) return;
      animated = true;

      // Animate container card
      animate(card, {
        opacity: [0, 1],
        translateY: [35, 0],
        duration: 800,
        ease: 'outQuart',
      });

      // Animate header
      if (header) {
        animate(header, {
          opacity: [0, 1],
          translateY: [20, 0],
          duration: 600,
          delay: 150,
          ease: 'outQuart',
        });
      }

      // Animate tech cards with staggered entrance
      if (items.length > 0) {
        animate(items, {
          opacity: [0, 1],
          translateY: [25, 0],
          scale: [0.9, 1],
          duration: 650,
          delay: stagger(60, { start: 250 }),
          ease: 'outBack(1.4)',
        });
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            triggerEntrance();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.15 }
    );

    observer.observe(card);

    // 3. Interactive hover animation on tech icons with anime.js
    items.forEach((item) => {
      const icon = item.querySelector(".tech-stack-icon");
      if (!icon) return;

      item.addEventListener("mouseenter", () => {
        animate(icon, {
          scale: 1.15,
          rotate: [-4, 4, 0],
          duration: 400,
          ease: 'outBack(2)',
        });
      });

      item.addEventListener("mouseleave", () => {
        animate(icon, {
          scale: 1,
          rotate: 0,
          duration: 300,
          ease: 'outQuad',
        });
      });
    });
  }

  initTechStack();
  document.addEventListener("astro:page-load", initTechStack);
</script>
