---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import pokeGuessImg from "../assets/pokeguess_redux.webp";

interface AppItem {
  name: string;
  category: string;
  version: string;
  description: string;
  tags: string[];
  image: ImageMetadata;
  playStoreUrl: string;
  githubUrl: string;
  status?: string;
}

const apps: AppItem[] = [
  {
    name: "PokeGuess Redux",
    category: "Entretenimiento",
    version: "v1.3",
    description:
      "Pon a prueba tus conocimientos sobre Pokémon en este divertido juego de deducción inspirado en los clásicos juegos de adivinanzas. Introduce el nombre de un Pokémon y usa las pistas para descubrir cuál es.",
    tags: ["Kotlin", "Jetpack Compose", "Room DB", "Retrofit", "MVVM", "Hilt", "Pokedex API"],
    image: pokeGuessImg,
    playStoreUrl: "https://play.google.com/store/apps/details?id=com.watsidev.pokeguessredux&pcampaignid=web_share",
    githubUrl: "https://github.com/WatsiDev/PokeGuess-GameAndroid",
    status: "Disponible en Play Store",
  }
];
---

<!-- Outer tall wrapper providing scroll distance for the horizontal pinning -->
<section id="apps-section" class="relative w-full" style="height: 300vh;">
  <!-- Ambient background glow behind the pinned section -->
  <div
    class="pointer-events-none absolute top-1/3 right-10 w-[550px] h-[550px] rounded-full blur-3xl opacity-15 bg-w-accent"
    aria-hidden="true"
  >
  </div>

  <!-- Sticky container pinned at top taking full screen height -->
  <div class="sticky top-0 h-screen w-full overflow-hidden flex flex-col justify-center bg-w-base">
    
    <!-- Section Header (Stays visible while scrolling horizontally) -->
    <div class="w-full px-6 sm:px-12 lg:px-24 mb-4 sm:mb-6 lg:mb-8 z-10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 max-w-7xl">
        <div class="flex flex-col gap-2.5">
          <!-- Eyebrow -->
          <div class="flex items-center gap-3 text-xs font-mono tracking-widest uppercase text-w-accent">
            <span class="w-8 h-px bg-w-accent"></span>
            <span class="flex items-center gap-1.5 font-semibold">
              <Icon name="simple-icons:googleplay" class="w-3.5 h-3.5" aria-hidden="true" />
              Portafolio Oficial
            </span>
            <span class="text-w-muted/40">•</span>
            <span class="text-w-muted font-normal">W Studios Suite</span>
          </div>

          <!-- Title -->
          <h2 class="font-display text-3xl sm:text-5xl lg:text-6xl font-bold text-w-text tracking-tight leading-[1.1]">
            Aplicaciones <span class="text-w-muted font-semibold">desarrolladas</span>
          </h2>
        </div>

        <!-- Scroll progress indicator & counter -->
        <div class="hidden sm:flex items-center gap-4 font-mono text-xs text-w-muted pb-1">
          <div class="flex items-center gap-1">
            <span id="apps-current-index" class="text-w-text font-bold text-base">01</span>
            <span class="text-w-muted/40">/</span>
            <span>0{apps.length}</span>
          </div>
          <div class="w-28 h-1.5 bg-w-surface border border-w-border/60 rounded-full overflow-hidden">
            <div id="apps-scroll-bar" class="h-full bg-w-accent w-full rounded-full transition-all duration-100 ease-out"></div>
          </div>
          <span class="text-[11px] text-w-muted/60 uppercase tracking-wider">Deslizar horizontal</span>
        </div>
      </div>
    </div>

    <!-- Horizontal scroll track containing the large app cards -->
    <div class="w-full overflow-hidden py-2">
      <div
        id="apps-track"
        class="flex items-center gap-6 sm:gap-8 lg:gap-10 px-6 sm:px-12 lg:px-24 will-change-transform"
        style="width: max-content; transform: translate3d(0, 0, 0);"
      >
        {
          apps.map((app, index) => (
            <article
              class="app-card group relative flex flex-col md:flex-row rounded-2xl sm:rounded-3xl border border-w-border/70 bg-w-surface/30 backdrop-blur-md overflow-hidden shadow-2xl transition-all duration-300 hover:border-w-accent/40 hover:bg-w-surface/50 w-[86vw] sm:w-[80vw] md:w-[75vw] max-w-[940px] lg:max-w-[1020px] h-[550px] sm:h-[580px] md:h-[500px] lg:h-[540px] flex-shrink-0"
            >
              <!-- TOP ON MOBILE (1/3 height) / RIGHT ON DESKTOP (1/3 width): Edge-to-edge cropped app image using Astro Image -->
              <div class="order-1 md:order-2 w-full h-[33%] md:w-1/3 md:h-full relative overflow-hidden bg-w-surface/80 border-b md:border-b-0 md:border-l border-w-border/40 flex-shrink-0">
                <Image
                  src={app.image}
                  alt={`Captura de pantalla de ${app.name}`}
                  class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                />
                <!-- Subtle gradient fade on the inner edge of image -->
                <div
                  class="absolute inset-y-0 left-0 w-8 sm:w-12 bg-gradient-to-r from-w-surface/40 to-transparent pointer-events-none hidden md:block"
                  aria-hidden="true"
                >
                </div>
                <div
                  class="absolute inset-x-0 bottom-0 h-8 bg-gradient-to-t from-w-surface/60 to-transparent pointer-events-none md:hidden"
                  aria-hidden="true"
                >
                </div>
              </div>

              <!-- BOTTOM ON MOBILE (2/3 height) / LEFT ON DESKTOP (2/3 width): App information, metadata, tags and action buttons -->
              <div class="order-2 md:order-1 w-full h-[67%] md:w-2/3 md:h-full flex flex-col justify-between p-5 sm:p-7 md:p-8 lg:p-10 z-10 overflow-hidden">
                
                <!-- Card Header -->
                <div class="flex flex-col gap-2 sm:gap-3">
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-xs font-mono tracking-wider uppercase text-w-accent font-semibold">
                      0{index + 1} / {app.category}
                    </span>
                    <span class="text-[10px] sm:text-[11px] font-mono px-2.5 py-0.5 rounded-full border border-w-border/60 bg-w-base/60 text-w-muted">
                      {app.version}
                    </span>
                  </div>

                  <h3 class="font-display text-xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-w-text tracking-tight group-hover:text-white transition-colors">
                    {app.name}
                  </h3>

                  <p class="text-xs sm:text-sm lg:text-base text-w-muted font-normal leading-relaxed line-clamp-2 sm:line-clamp-3 md:line-clamp-4">
                    {app.description}
                  </p>
                </div>

                <!-- Card Bottom Section: Tags + Action Links -->
                <div class="flex flex-col gap-3 sm:gap-4 md:gap-5 pt-3 sm:pt-4 border-t border-w-border/40">
                  <!-- Tech stack chips -->
                  <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
                    {app.tags.map((tag) => (
                      <span class="text-[9px] sm:text-[10px] md:text-[11px] font-mono px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-md border border-w-border/50 bg-w-base/50 text-w-muted/80">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <!-- Action Buttons (Google Play & GitHub) -->
                  <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
                    <a
                      href={app.playStoreUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-xl bg-w-accent hover:bg-w-accent-hover text-white font-medium text-xs sm:text-sm transition-all duration-300 shadow-lg shadow-w-accent/20 hover:scale-105 active:scale-95"
                    >
                      <Icon name="simple-icons:googleplay" class="w-3.5 h-3.5 sm:w-4 sm:h-4" aria-hidden="true" />
                      <span>Google Play</span>
                    </a>

                    <a
                      href={app.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-3.5 sm:px-5 py-2 sm:py-2.5 rounded-xl border border-w-border/80 bg-w-base/60 hover:bg-w-surface text-w-text hover:text-white font-medium text-xs sm:text-sm transition-all duration-300 hover:border-w-muted active:scale-95"
                    >
                      <Icon name="simple-icons:github" class="w-3.5 h-3.5 sm:w-4 sm:h-4" aria-hidden="true" />
                      <span>Ver Código</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          ))
        }

        <!-- Final Teaser Card -->
        <article
          class="app-card group relative flex flex-col justify-between p-6 sm:p-8 md:p-10 rounded-2xl sm:rounded-3xl border border-dashed border-w-border/80 bg-w-surface/20 backdrop-blur-md w-[280px] sm:w-[320px] md:w-[360px] lg:w-[380px] h-[550px] sm:h-[580px] md:h-[500px] lg:h-[540px] flex-shrink-0 text-center items-center justify-center gap-6"
        >
          <div class="flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-2xl border border-w-border/80 bg-w-base/80 text-w-accent">
            <Icon name="ph:sparkle-fill" class="w-7 h-7 sm:w-8 sm:h-8" aria-hidden="true" />
          </div>

          <div class="flex flex-col gap-2">
            <h3 class="font-display text-xl sm:text-2xl lg:text-3xl font-bold text-w-text">
              Más Proyectos en Camino
            </h3>
            <p class="text-xs sm:text-sm text-w-muted leading-relaxed max-w-xs">
              Nuevas herramientas nativas para Android actualmente en fase de arquitectura y desarrollo activo.
            </p>
          </div>

          <a
            href="https://github.com/watsidev"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-w-border/80 bg-w-base/60 hover:bg-w-surface text-w-text text-xs font-mono transition-colors"
          >
            <Icon name="simple-icons:github" class="w-4 h-4" aria-hidden="true" />
            <span>Seguir en GitHub</span>
          </a>
        </article>
      </div>
    </div>

  </div>
</section>

<script>
  function initAppsHorizontalScroll() {
    const section = document.getElementById("apps-section");
    const track = document.getElementById("apps-track");
    const scrollBar = document.getElementById("apps-scroll-bar");
    const currentIndex = document.getElementById("apps-current-index");

    if (!section || !track) return;

    let sectionTop = 0;
    let maxScrollDistance = 0;
    let maxTranslateX = 0;
    let totalCards = 1;

    // Cache metrics to avoid Layout Thrashing / Reflows during scroll
    const updateMetrics = () => {
      const sectionHeight = section.offsetHeight;
      const windowHeight = window.innerHeight;
      sectionTop = section.offsetTop;
      maxScrollDistance = Math.max(1, sectionHeight - windowHeight);
      const trackWidth = track.scrollWidth;
      const viewportWidth = window.innerWidth;
      maxTranslateX = Math.max(0, trackWidth - viewportWidth + 64);
      totalCards = Math.max(1, document.querySelectorAll('.app-card').length - 1);
    };

    updateMetrics();
    window.addEventListener("resize", updateMetrics, { passive: true });

    let rafId: number | null = null;

    const onScroll = () => {
      if (rafId) cancelAnimationFrame(rafId);

      rafId = requestAnimationFrame(() => {
        const scrollY = window.scrollY;

        // Skip calculations if completely outside the section
        if (scrollY < sectionTop - 200 || scrollY > sectionTop + maxScrollDistance + 200) {
          return;
        }

        // Progress clamp (0 to 1)
        const currentScroll = Math.max(0, Math.min(scrollY - sectionTop, maxScrollDistance));
        const progress = currentScroll / maxScrollDistance;
        const translateX = progress * maxTranslateX;

        track.style.transform = `translate3d(-${translateX}px, 0, 0)`;

        // Update progress bar
        if (scrollBar) {
          const barWidth = Math.max(20, progress * 100);
          scrollBar.style.width = `${barWidth}%`;
        }

        // Update current card indicator
        if (currentIndex) {
          const currentCardNumber = Math.min(totalCards, Math.floor(progress * totalCards) + 1);
          currentIndex.textContent = `0${currentCardNumber}`;
        }
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  initAppsHorizontalScroll();
  document.addEventListener("astro:page-load", initAppsHorizontalScroll);
</script>
