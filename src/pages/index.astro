---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout title="Plantilla Astro Estática" description="Una base sólida con las mejores herramientas integradas.">
  <main class="container mx-auto px-4 py-12 max-w-4xl font-sans text-onSecondary">
    <header class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4 text-accent font-[family-name:var(--font-orbitron)]">Plantilla Astro Estática</h1>
      <p class="text-xl text-onPrimary">Una base sólida con las mejores herramientas integradas.</p>
    </header>

    <section class="mb-12 bg-primary rounded-2xl shadow-lg p-8 border border-accent/20">
      <h2 class="text-2xl font-bold mb-6 text-accent border-b border-secondary pb-2">Librerías Implementadas</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <li class="flex items-center space-x-3">
          <Icon name="bytesize:lightning" is:inline class="w-6 h-6 stroke-[1px] text-accent" />
          <span class="font-semibold text-lg text-onSecondary">Astro</span>
          <span class="text-sm text-onPrimary ml-2">(Framework)</span>
        </li>
        <li class="flex items-center space-x-3">
          <Icon name="bytesize:code" is:inline class="w-6 h-6 stroke-[1px] text-accent" />
          <span class="font-semibold text-lg text-onSecondary">Tailwind CSS v4</span>
          <span class="text-sm text-onPrimary ml-2">(Estilos, con Vite plugin)</span>
        </li>
        <li class="flex items-center space-x-3">
          <Icon name="bytesize:star" is:inline class="w-6 h-6 stroke-[1px] text-accent" />
          <span class="font-semibold text-lg text-onSecondary">Anime.js</span>
          <span class="text-sm text-onPrimary ml-2">(Animaciones)</span>
        </li>
        <li class="flex items-center space-x-3">
          <Icon name="bytesize:heart" is:inline class="w-6 h-6 stroke-[1px] text-accent" />
          <span class="font-semibold text-lg text-onSecondary">Astro Icon</span>
          <span class="text-sm text-onPrimary ml-2">(Iconos SVG)</span>
        </li>
        <li class="flex items-center space-x-3">
          <Icon name="bytesize:search" is:inline class="w-6 h-6 stroke-[1px] text-accent" />
          <span class="font-semibold text-lg text-onSecondary">Astro Sitemap</span>
          <span class="text-sm text-onPrimary ml-2">(SEO)</span>
        </li>
        <li class="flex items-center space-x-3">
          <Icon name="bytesize:search" is:inline class="w-6 h-6 stroke-[1px] text-accent" />
          <span class="font-semibold text-lg text-onSecondary">Astro SEO</span>
          <span class="text-sm text-onPrimary ml-2">(Meta tags)</span>
        </li>
        <li class="flex items-center space-x-3">
          <Icon name="bytesize:edit" is:inline class="w-6 h-6 stroke-[1px] text-accent" />
          <span class="font-semibold text-lg text-onSecondary">Prettier</span>
          <span class="text-sm text-onPrimary ml-2">(Formateo con plugins para Astro y Tailwind)</span>
        </li>
      </ul>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6 text-accent">Instalación de Dependencias</h2>
      <div class="bg-primary rounded-xl overflow-hidden shadow-md border border-accent/20">
        <div class="bg-secondary px-4 py-2 text-sm text-onPrimary font-mono flex items-center justify-between border-b border-accent/10">
          <span>Terminal</span>
          <span class="text-xs bg-primary px-2 py-1 rounded text-accent">pnpm</span>
        </div>
        <pre class="p-4 overflow-x-auto"><code class="text-onSecondary text-sm font-mono">pnpm install @astrojs/sitemap @tailwindcss/vite animejs astro astro-icon astro-seo tailwindcss
pnpm install -D prettier prettier-plugin-astro prettier-plugin-tailwindcss
pnpm add @iconify-json/bytesize</code></pre>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-6 text-accent">Fragmentos de Configuración Destacada</h2>
      
      <div class="mb-6 bg-primary rounded-xl overflow-hidden shadow-md border border-accent/20">
        <div class="bg-secondary px-4 py-2 text-sm text-onPrimary font-mono border-b border-accent/10">astro.config.mjs - Tailwind CSS v4 (Vite Plugin)</div>
        <pre class="p-4 overflow-x-auto"><code class="text-onSecondary text-sm font-mono"><span class="text-accent">import</span> &#123; defineConfig &#125; <span class="text-accent">from</span> <span class="text-onPrimary">'astro/config'</span>;
<span class="text-accent">import</span> tailwindcss <span class="text-accent">from</span> <span class="text-onPrimary">'@tailwindcss/vite'</span>;

<span class="text-accent">export default</span> <span class="text-onSecondary">defineConfig</span>(&#123;
  vite: &#123;
    plugins: [<span class="text-onSecondary">tailwindcss</span>()],
  &#125;
&#125;);</code></pre>
      </div>

      <div class="bg-primary rounded-xl overflow-hidden shadow-md border border-accent/20">
        <div class="bg-secondary px-4 py-2 text-sm text-onPrimary font-mono border-b border-accent/10">astro.config.mjs - Integración de Fuentes (Fontsource)</div>
        <pre class="p-4 overflow-x-auto"><code class="text-onSecondary text-sm font-mono"><span class="text-accent">import</span> &#123; defineConfig, fontProviders &#125; <span class="text-accent">from</span> <span class="text-onPrimary">'astro/config'</span>;

<span class="text-accent">export default</span> <span class="text-onSecondary">defineConfig</span>(&#123;
  fonts: [&#123;
    provider: fontProviders.<span class="text-onSecondary">fontsource</span>(),
    name: <span class="text-onPrimary">'Orbitron'</span>,
    cssVariable: <span class="text-onPrimary">'--font-orbitron'</span>
  &#125;]
&#125;);</code></pre>
      </div>
    </section>

  </main>

  <script>
    import { animate, stagger } from 'animejs';

    // Animación para el encabezado
    animate('header', {
      y: [-30, 0],
      opacity: [0, 1],
      duration: 1000,
      ease: 'outCubic'
    });

    // Animación escalonada para las secciones
    animate('section', {
      y: [30, 0],
      opacity: [0, 1],
      duration: 800,
      delay: stagger(200, { start: 200 }),
      ease: 'outQuart'
    });

    // Animación escalonada para los elementos de la lista de herramientas
    animate('ul li', {
      x: [-20, 0],
      opacity: [0, 1],
      duration: 800,
      delay: stagger(100, { start: 600 }),
      ease: 'outQuart'
    });
  </script>
</Layout>
